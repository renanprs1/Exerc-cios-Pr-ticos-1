package Exercicos1;

import java.util.Scanner;

// Exceção personalizada herdando de RuntimeException
class IdadeInvalidaException extends RuntimeException {
    public IdadeInvalidaException(String mensagem) {
        super(mensagem);
    }
}

public class ValidacaoIdade {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        try {
            System.out.print("Digite a sua idade: ");
            int idade = scanner.nextInt();

            validarIdade(idade);
            System.out.println("Idade cadastrada com sucesso: " + idade);

        } catch (IdadeInvalidaException e) {
            System.out.println("Erro de Validação: " + e.getMessage());
        } catch (Exception e) {
            System.out.println("Erro: Entrada inválida!");
        } finally {
            scanner.close();
        }
    }

    public static void validarIdade(int idade) {
        if (idade < 0 || idade > 150) {
            throw new IdadeInvalidaException("A idade deve estar entre 0 e 150 anos. Valor informado: " + idade);
        }
    }
}
